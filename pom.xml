<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Herdamos do starter-parent do Spring Boot 2.7.x (ultima linha javax.*).
         NAO subir para 3.x: exigiria Jakarta (jakarta.*) e Tomcat 10+, e o
         objetivo do estudo e praticar o legado javax.* / Tomcat 9. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 2.7.x e a ultima linha em javax.* e roda em Java 8. -->
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>br.com.sansuy</groupId>
    <artifactId>pedidos</artifactId>
    <version>1.0.0</version>
    <!-- WAR: sera publicado em webapps/ de um Tomcat 9 standalone (Fase 2). -->
    <packaging>war</packaging>
    <name>sansuy-pedidos</name>
    <description>Sistema de pedidos e producao de laminados de PVC (projeto de estudo)</description>

    <properties>
        <!-- Alvo Java 8: baseline literal do anuncio ("Java 8+") e maxima
             fidelidade ao legado. O container da Fase 2 usa tomcat:9-jdk8.
             Compilando num JDK mais novo (ex.: 21), o javac emite um aviso
             "source 8 is obsolete" — cosmetico, nao impede o build. -->
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Camada web REST (Spring MVC) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistencia: JPA/Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation (javax.validation) para os DTOs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Driver PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Tomcat fornecido pelo container (nao embutido no WAR).
             provided = compila contra a API de servlet, mas nao empacota. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Testes: JUnit 5 + Mockito + Spring Test (Fase 5) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Nome final sem versao: gera target/sansuy-pedidos.war -->
        <finalName>sansuy-pedidos</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Nao ha web.xml (config 100% Java); nao falhar por isso. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
